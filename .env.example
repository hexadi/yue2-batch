YUE2_MODEL=m-a-p/YuE2-3B
YUE2_VAE=m-a-p/YuE2-Vae
YUE2_DEVICE=cuda
YUE2_MEMORY_BUDGET_GIB=24
YUE2_BACKEND=torch
YUE2_QUANTIZATION=none
YUE2_OFFLOAD_AR=false

HF_HOME=/workspace/huggingface
BATCH_OUTPUT_DIR=/workspace/yue2-batch-output
BATCH_MANIFEST_URL=
BATCH_MANIFEST_JSON=
BATCH_MANIFEST_FILE=/workspace/batch.json
BATCH_MAX_JOBS=50
BATCH_CONTINUE_ON_ERROR=true
BATCH_CLEANUP_AFTER_UPLOAD=false

S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PREFIX=yue2/batches
S3_URL_TTL_SECONDS=86400
YUE2_UPLOAD_ALL_ARTIFACTS=false
